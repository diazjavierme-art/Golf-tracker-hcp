  <div class="gen-steps">
    <div class="gen-item active" id="gs-0"><div class="gen-dot"></div>Analizando nivel y errores</div>
    <div class="gen-item" id="gs-1"><div class="gen-dot"></div>Generando plan de golf</div>
    <div class="gen-item" id="gs-2"><div class="gen-dot"></div>Creando plan físico</div>
    <div class="gen-item" id="gs-3"><div class="gen-dot"></div>Diseñando plan de dieta</div>
