<div class="toast" id="toast"></div>

<script>
// ─── CONFIG ───────────────────────────────────────────
const API_KEY = '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';
const TOTAL_STEPS = 6;
let currentStep = 0;

// ─── INIT ─────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function() {
  // If already registered, go to app
  const done    = localStorage.getItem('onboarding_done');
  const profile = JSON.parse(localStorage.getItem('golf_profile') || 'null');
  const hcp     = localStorage.getItem('hcp_manual');
  if (done && profile && profile.nombre && hcp) {
    window.location.href = 'index.html';
    return;
  }
  initProgress();
});

function initProgress() {
  const dots = document.getElementById('progress-dots');
  dots.innerHTML = Array.from({length: TOTAL_STEPS}, (_, i) =>
    `<div class="progress-dot ${i===0?'active':'rest'}" id="pd-${i}"></div>`
  ).join('');
  updateLabel();
}

function updateProgress(step) {
  for (let i = 0; i < TOTAL_STEPS; i++) {
    const d = document.getElementById('pd-' + i);
    if (!d) continue;
    d.className = 'progress-dot ' + (i < step ? 'done' : i === step ? 'active' : '');
  }
  updateLabel();
}

function updateLabel() {
  const el = document.getElementById('step-label');
  if (el) el.textContent = 'Paso ' + (currentStep + 1) + ' de ' + TOTAL_STEPS;
}

// ─── NAVIGATION ───────────────────────────────────────
function next(step) {
  if (step === 0) {
    if (!v('f-nombre')) { toast('⚠️ Introduce tu nombre'); return; }
    if (!v('f-hcp'))    { toast('⚠️ Introduce tu handicap'); return; }
  }
  if (step === 2) {
    if (!getOne('c-dias')) { toast('⚠️ Selecciona los días disponibles'); return; }
  }
  show(step, step + 1);
}

function back(step) {
  show(step, step - 1);
}

function show(from, to) {
  document.getElementById('step-' + from).classList.remove('active');
  document.getElementById('step-' + to).classList.add('active');
  currentStep = to;
  updateProgress(to);
  window.scrollTo({top: 0, behavior: 'smooth'});
}

// ─── CHIPS ────────────────────────────────────────────
function tog(el) { el.classList.toggle('on'); }
function one(groupId, el) {
  document.querySelectorAll('#' + groupId + ' .chip').forEach(c => c.classList.remove('on'));
  el.classList.add('on');
}
function getChips(groupId) {
  return [...document.querySelectorAll('#' + groupId + ' .chip.on')].map(c => c.textContent.trim());
}
function getOne(groupId) { return getChips(groupId)[0] || ''; }

// ─── HELPERS ──────────────────────────────────────────
function v(id) { return document.getElementById(id)?.value.trim(); }

function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

// ─── COLLECT DATA ─────────────────────────────────────
function collectData() {
  return {
    nombre:    v('f-nombre') || '',
    edad:      v('f-edad') || '—',
    hcp:       parseFloat(v('f-hcp')) || 0,
    objetivo:  parseFloat(v('f-obj')) || null,
    errores:   getChips('c-errores'),
    torneos:   getOne('c-torneos'),
    coach:     getOne('c-coach'),
    dias:      getOne('c-dias') || '3 días',
    duracion:  getOne('c-duracion') || '1.5 horas',
    acceso:    getChips('c-acceso'),
    forma:     getOne('c-forma') || 'Activo ocasional',
    lesiones:  getChips('c-lesiones'),
    objFisico: getChips('c-objfisico'),
    peso:      v('f-peso') || '—',
    pesoObj:   getOne('c-pesoobj') || 'Mantener peso',
    alergias:  getChips('c-alergias'),
    horario:   getOne('c-horario') || 'Tardes',
    prioridad: getOne('c-prioridad') || 'Bajar HCP rápido',
    estilo:    getOne('c-estilo') || 'Con estructura y métricas',
    extra:     v('f-extra') || '',
  };
}

// ─── SAVE PROFILE ─────────────────────────────────────
function saveProfile(perfil) {
  localStorage.setItem('golf_profile', JSON.stringify({
    nombre: perfil.nombre, hcp: perfil.hcp.toString(), rfeg: ''
  }));
  localStorage.setItem('golf_perfil_completo', JSON.stringify(perfil));
  localStorage.setItem('hcp_manual', perfil.hcp.toString());
  localStorage.setItem('hcp_history', JSON.stringify([{
    hcp: perfil.hcp, date: new Date().toISOString(), note: 'Inicio'
  }]));
  if (perfil.objetivo && perfil.objetivo < perfil.hcp) {
    localStorage.setItem('hcp_objetivo', perfil.objetivo.toString());
  }
}

// ─── SKIP / GENERIC ───────────────────────────────────
function saltarIA() {
  const perfil = collectData();
  if (!perfil.nombre) { toast('⚠️ Introduce al menos tu nombre en el paso 1'); return; }
  saveProfile(perfil);
  localStorage.setItem('onboarding_done', '1');
  window.location.href = 'index.html';
}

// ─── GENERATE WITH AI ─────────────────────────────────
async function generar() {
  const perfil = collectData();
  if (!perfil.nombre) { toast('⚠️ Vuelve al paso 1 e introduce tu nombre'); return; }

  saveProfile(perfil);

  // Show generating screen
  document.querySelector('.step-wrap').style.display = 'none';
  document.querySelector('.progress-wrap').style.display = 'none';
  document.getElementById('gen-screen').classList.add('active');

  const genItems = ['gs-0','gs-1','gs-2','gs-3','gs-4'];
  let gi = 0;
  function advGen() {
    if (gi > 0) document.getElementById(genItems[gi-1]).className = 'gen-item done';
    if (gi < genItems.length) { document.getElementById(genItems[gi]).className = 'gen-item active'; gi++; }
  }
  advGen();
  const timer = setInterval(advGen, 2800);

  const p = perfil;
  const perfilStr = `Nombre: ${p.nombre}, Edad: ${p.edad}, HCP: ${p.hcp}, Objetivo HCP: ${p.objetivo||'no indicado'}
Errores: ${p.errores.join(', ')||'no indicado'}, Torneos: ${p.torneos}, Entrenador: ${p.coach}
Días/sem: ${p.dias}, Duración: ${p.duracion}, Instalaciones: ${p.acceso.join(', ')}
Forma: ${p.forma}, Lesiones: ${p.lesiones.join(', ')}, Objetivos físicos: ${p.objFisico.join(', ')}
Peso: ${p.peso}kg, Objetivo peso: ${p.pesoObj}, Restricciones: ${p.alergias.join(', ')}
Horario golf: ${p.horario}, Prioridad: ${p.prioridad}, Estilo: ${p.estilo}
Notas: ${p.extra||'ninguna'}`;

  try {
    // ── Golf plan ──
    document.getElementById('gen-status').textContent = 'Generando plan de golf...';
    const numDias = p.dias.startsWith('2') ? 2 : p.dias.startsWith('3') ? 3 : 4;
    const golfPrompt = `Eres un entrenador de golf experto. Genera un plan de entrenamiento personalizado en JSON para:\n${perfilStr}\n\nGenera exactamente ${numDias} días.\n\nResponde SOLO con JSON válido (sin backticks, sin texto extra):\n{"days":{"1":{"title":"Día 1 · [tema]","subtitle":"[dur] · [desc]","color":"#e07830","blocks":[{"id":"d1b1","name":"[nombre]","emoji":"[emoji]","time":"[tiempo]","objetivo":"[max 80 chars]","exercises":[{"id":"d1e1","name":"[nombre]","meta":"[metrica]","target":10,"desc":"[instruccion concreta]"}]}]},"2":{...},"3":{...}}}\n\nColores: día1=#e07830 día2=#e8a63a día3=#e0623a día4=#f5a054. Target entre 3-25. Español. Nivel HCP ${p.hcp}.`;

    const golfRes = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-api-key': API_KEY, 'anthropic-version': '2023-06-01' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514', max_tokens: 4000,
        messages: [{ role: 'user', content: golfPrompt }]
      })
    });
    const golfData = await golfRes.json();
    const golfRaw  = golfData.content?.[0]?.text || '';
    const golfJson = JSON.parse(golfRaw.replace(/```json\n?/g,'').replace(/```\n?/g,'').trim());
    if (golfJson.days) {
      const days = {};
      Object.keys(golfJson.days).forEach(k => { days[parseInt(k)] = golfJson.days[k]; });
      localStorage.setItem('golf_custom_plan', JSON.stringify(days));
    }

    // ── Fitness plan ──
    document.getElementById('gen-status').textContent = 'Generando plan físico...';
    const fitPrompt = `Eres un preparador físico experto en golf. Genera plan semanal en JSON para:\n${perfilStr}\n\nResponde SOLO JSON válido:\n{"semana":[{"dia":"Lunes","nombre":"[sesion]","duracion":"[X min]","objetivo":"[obj]","ejercicios":[{"nombre":"[ej]","series":"[X x Y reps]","descanso":"[X seg]","notas":"[como]"}]}],"frecuencia":"[X dias/sem]","nota_general":"[consejo]"}\n\nAdapta a lesiones: ${p.lesiones.join(',')}, objetivos: ${p.objFisico.join(',')}.`;

    const fitRes = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-api-key': API_KEY, 'anthropic-version': '2023-06-01' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514', max_tokens: 3000,
        messages: [{ role: 'user', content: fitPrompt }]
      })
    });
    const fitData = await fitRes.json();
    const fitRaw  = fitData.content?.[0]?.text || '';
    const fitJson = JSON.parse(fitRaw.replace(/```json\n?/g,'').replace(/```\n?/g,'').trim());
    localStorage.setItem('golf_custom_fit', JSON.stringify(fitJson));

    // ── Diet plan ──
    document.getElementById('gen-status').textContent = 'Generando plan de dieta...';
    const dietPrompt = `Eres nutricionista deportivo experto en golf. Genera plan de dieta semanal en JSON para:\n${perfilStr}\n\nResponde SOLO JSON válido:\n{"kcal_objetivo":2000,"distribucion":{"proteinas":"30%","carbos":"45%","grasas":"25%"},"dias":[{"dia":"Lunes","tipo":"Entreno","comidas":[{"nombre":"Desayuno","plato":"[plato]","ingredientes":"[lista]","kcal":400,"proteinas_g":20,"nota_golf":"[consejo opcional]"}]}],"lista_compra":["[item]"],"consejos_campo":["[consejo]"]}\n\nRespeta restricciones: ${p.alergias.join(', ')}. Horario golf: ${p.horario}. Objetivo: ${p.pesoObj}.`;

    const dietRes = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-api-key': API_KEY, 'anthropic-version': '2023-06-01' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514', max_tokens: 4000,
        messages: [{ role: 'user', content: dietPrompt }]
      })
    });
    const dietData = await dietRes.json();
    const dietRaw  = dietData.content?.[0]?.text || '';
    const dietJson = JSON.parse(dietRaw.replace(/```json\n?/g,'').replace(/```\n?/g,'').trim());
    localStorage.setItem('golf_custom_diet', JSON.stringify(dietJson));

    clearInterval(timer);
    genItems.forEach(id => { document.getElementById(id).className = 'gen-item done'; });
    document.getElementById('gen-status').textContent = '¡Planes listos! 🎉';
    localStorage.setItem('onboarding_done', '1');

    setTimeout(() => { window.location.href = 'index.html'; }, 1200);

  } catch(err) {
    clearInterval(timer);
    console.error(err);
    // Save what we have and go to app anyway
    localStorage.setItem('onboarding_done', '1');
    document.getElementById('gen-status').textContent = 'Perfil guardado. Cargando app...';
    setTimeout(() => { window.location.href = 'index.html'; }, 1000);
  }
}
</script>
